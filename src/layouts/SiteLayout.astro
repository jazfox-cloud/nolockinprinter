---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string | false;
  robots?: string;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  robots = 'index, follow',
} = Astro.props;
const siteUrl = 'https://nolockinprinter.com';
const canonicalUrl = canonical === false ? undefined : new URL(canonical, siteUrl).toString();
const pageTitle = title.includes('No Lock-In Printer') ? title : `${title} | No Lock-In Printer`;
const isIndexable = !robots.toLowerCase().includes('noindex');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="google-adsense-account" content="ca-pub-2134598094429002" />
    <meta name="theme-color" content="#116d65" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={`${siteUrl}/images/printer-workflow.svg`} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="900" />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${siteUrl}/images/printer-workflow.svg`} />
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500
      });
    </script>
    {
      isIndexable && (
        <script
          is:inline
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2134598094429002"
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">N</span>
          <span>No Lock-In Printer</span>
        </a>
        <div class="nav-links">
          <a href="/guides/no-subscription-printers/">No-subscription picks</a>
          <a href="/guides/linux-compatible-printers/">Linux printers</a>
          <a href="/openprinter/">OpenPrinter tracker</a>
          <a href="/openprinter/alternatives/">Alternatives</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="container">
        <div>
          <strong>No Lock-In Printer</strong>
          <p>Independent buyer notes. Last reviewed July 2026.</p>
        </div>
        <div class="footer-links" aria-label="Footer navigation">
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/editorial-policy/">Editorial policy</a>
          <a href="/affiliate-disclosure/">Affiliate disclosure</a>
          <a href="/privacy/">Privacy</a>
          <button class="privacy-choice-button" type="button" data-analytics-choices>Analytics choices</button>
          <a href="/terms/">Terms</a>
        </div>
      </div>
    </footer>
    <div class="analytics-consent" data-analytics-consent hidden>
      <div class="analytics-consent__panel" role="dialog" aria-live="polite" aria-label="Analytics choices">
        <div>
          <strong>Analytics choices</strong>
          <p>No Lock-In Printer uses Google Analytics 4 only after you allow analytics. Ad choices stay separate.</p>
        </div>
        <div class="analytics-consent__actions">
          <button type="button" class="button secondary" data-analytics-reject>Reject</button>
          <button type="button" class="button" data-analytics-accept>Allow analytics</button>
        </div>
      </div>
    </div>
    <script is:inline>
      (() => {
        const measurementId = 'G-SF2QJEJ57G';
        const productionHost = 'nolockinprinter.com';
        const storageKey = 'nolockinprinter_analytics_consent';
        const isProductionHost = window.location.hostname === productionHost;
        const banner = document.querySelector('[data-analytics-consent]');
        const choicesButtons = document.querySelectorAll('[data-analytics-choices]');
        let gtagLoaded = false;
        let configured = false;

        function gtag() {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(arguments);
        }

        function ensureGtag() {
          window.dataLayer = window.dataLayer || [];
          window.gtag = gtag;
        }

        function updateConsent(analyticsStorage) {
          ensureGtag();
          gtag('consent', 'update', {
            analytics_storage: analyticsStorage,
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied'
          });
        }

        function loadGtag() {
          if (!isProductionHost || gtagLoaded || document.querySelector(`script[src*="googletagmanager.com/gtag/js?id=${measurementId}"]`)) {
            return;
          }
          gtagLoaded = true;
          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
          document.head.appendChild(script);
        }

        function configureAnalytics() {
          if (!isProductionHost || configured) {
            return;
          }
          configured = true;
          ensureGtag();
          gtag('js', new Date());
          gtag('config', measurementId, {
            anonymize_ip: true,
            allow_google_signals: false,
            allow_ad_personalization_signals: false
          });
          loadGtag();
        }

        function hideBanner() {
          if (banner) {
            banner.hidden = true;
          }
        }

        function showBanner() {
          if (banner) {
            banner.hidden = false;
          }
        }

        function acceptAnalytics() {
          try {
            window.localStorage.setItem(storageKey, 'analytics_granted');
          } catch {}
          updateConsent('granted');
          configureAnalytics();
          hideBanner();
        }

        function rejectAnalytics() {
          try {
            window.localStorage.setItem(storageKey, 'denied');
          } catch {}
          updateConsent('denied');
          hideBanner();
        }

        function getChoice() {
          try {
            return window.localStorage.getItem(storageKey);
          } catch {
            return null;
          }
        }

        document.querySelectorAll('[data-analytics-accept]').forEach((button) => {
          button.addEventListener('click', acceptAnalytics);
        });
        document.querySelectorAll('[data-analytics-reject]').forEach((button) => {
          button.addEventListener('click', rejectAnalytics);
        });
        choicesButtons.forEach((button) => {
          button.addEventListener('click', showBanner);
        });

        document.addEventListener('click', (event) => {
          const link = event.target instanceof Element ? event.target.closest('[data-analytics-content]') : null;
          if (!link || getChoice() !== 'analytics_granted' || !isProductionHost) {
            return;
          }
          const href = link instanceof HTMLAnchorElement ? link.href : '';
          const shouldDelayNavigation =
            href &&
            link.target !== '_blank' &&
            event.button === 0 &&
            !event.metaKey &&
            !event.ctrlKey &&
            !event.shiftKey &&
            !event.altKey;
          let navigated = false;
          const continueNavigation = () => {
            if (!shouldDelayNavigation || navigated) {
              return;
            }
            navigated = true;
            window.location.href = href;
          };
          if (shouldDelayNavigation) {
            event.preventDefault();
          }
          ensureGtag();
          gtag('event', 'select_content', {
            content_type: link.getAttribute('data-analytics-content') || 'content_card',
            content_slug: link.getAttribute('data-analytics-slug') || 'unknown',
            placement: link.getAttribute('data-analytics-placement') || 'body',
            transport_type: 'beacon',
            event_callback: continueNavigation,
            event_timeout: 1000
          });
          if (shouldDelayNavigation) {
            window.setTimeout(continueNavigation, 1200);
          }
        });

        const choice = getChoice();
        if (choice === 'analytics_granted') {
          updateConsent('granted');
          configureAnalytics();
        } else if (choice === 'denied') {
          updateConsent('denied');
        } else {
          showBanner();
        }
      })();
    </script>
  </body>
</html>
